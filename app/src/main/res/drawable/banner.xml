<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C9D3EA" />
            <corners android:radius="16dp" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="72dp" android:height="72dp">
        <shape android:shape="oval">
            <solid android:color="#121212" />
        </shape>
    </item>
    <item android:gravity="center" android:width="36dp" android:height="36dp">
        <shape android:shape="oval">
            <solid android:color="#FBE38E" />
        </shape>
    </item>
</layer-list>
